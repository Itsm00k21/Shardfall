{
  "name": "Shardfall",
  "globIgnorePaths": ["**/*.spec.luau", "tests/**"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Remotes": {
        "$className": "Folder",
        "RollShard": {
          "$className": "RemoteFunction"
        },
        "RollAnnounce": {
          "$className": "RemoteEvent"
        },
        "RollPaid": {
          "$className": "RemoteFunction"
        },
        "BuyPrism": {
          "$className": "RemoteFunction"
        },
        "BuyBoost": {
          "$className": "RemoteFunction"
        },
        "BuyForgeBoost": {
          "$className": "RemoteFunction"
        },
        "PolicyUpdated": {
          "$className": "RemoteEvent"
        },
        "GetProfile": {
          "$className": "RemoteFunction"
        },
        "GetOdds": {
          "$className": "RemoteFunction"
        },
        "EquipItem": {
          "$className": "RemoteFunction"
        },
        "UnequipItem": {
          "$className": "RemoteFunction"
        },
        "RemoveItem": {
          "$className": "RemoteFunction"
        },
        "DevGrant": {
          "$className": "RemoteFunction"
        },
        "ProfileUpdated": {
          "$className": "RemoteEvent"
        },
        "Attack": {
          "$className": "RemoteEvent"
        },
        "CombatFx": {
          "$className": "RemoteEvent"
        },
        "Dungeon": {
          "$className": "RemoteFunction"
        },
        "Craft": {
          "$className": "RemoteFunction"
        },
        "Salvage": {
          "$className": "RemoteFunction"
        },
        "BulkSalvage": {
          "$className": "RemoteFunction"
        },
        "SetItemLock": {
          "$className": "RemoteFunction"
        },
        "SetItemFavorite": {
          "$className": "RemoteFunction"
        },
        "BuyInventoryExpansion": {
          "$className": "RemoteFunction"
        },
        "UseTonic": {
          "$className": "RemoteFunction"
        },
        "FeedItem": {
          "$className": "RemoteFunction"
        },
        "SetAutoAttack": {
          "$className": "RemoteFunction"
        },
        "SetAutoFarm": {
          "$className": "RemoteFunction"
        },
        "Steer": {
          "$className": "RemoteEvent"
        },
        "Travel": {
          "$className": "RemoteFunction"
        },
        "BuyTravelPass": {
          "$className": "RemoteFunction"
        },
        "SetGraphicsQuality": {
          "$className": "RemoteFunction"
        },
        "SetShake": {
          "$className": "RemoteFunction"
        },
        "HavenPrompt": {
          "$className": "RemoteEvent"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 128,
        "StreamingTargetRadius": 512
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": false,
      "ShardfallServer": {
        "$path": "src/ServerScriptService/ShardfallServer"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "ShardfallClient": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/ShardfallClient"
        }
      }
    }
  }
}
