{
  "name": "Shardfall",
  "globIgnorePaths": ["**/*.spec.luau", "tests/**"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Remotes": {
        "$className": "Folder",
        "RollShard": {
          "$className": "RemoteFunction"
        },
        "RollPaid": {
          "$className": "RemoteFunction"
        },
        "GetProfile": {
          "$className": "RemoteFunction"
        },
        "GetOdds": {
          "$className": "RemoteFunction"
        },
        "EquipItem": {
          "$className": "RemoteFunction"
        },
        "UnequipItem": {
          "$className": "RemoteFunction"
        },
        "RemoveItem": {
          "$className": "RemoteFunction"
        },
        "DevGrant": {
          "$className": "RemoteFunction"
        },
        "ProfileUpdated": {
          "$className": "RemoteEvent"
        },
        "Attack": {
          "$className": "RemoteEvent"
        },
        "CombatFx": {
          "$className": "RemoteEvent"
        },
        "Dungeon": {
          "$className": "RemoteFunction"
        },
        "Craft": {
          "$className": "RemoteFunction"
        },
        "UseTonic": {
          "$className": "RemoteFunction"
        },
        "FeedItem": {
          "$className": "RemoteFunction"
        },
        "SetAutoAttack": {
          "$className": "RemoteFunction"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "ShardfallServer": {
        "$path": "src/ServerScriptService/ShardfallServer"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "ShardfallClient": {
          "$path": "src/StarterPlayer/StarterPlayerScripts/ShardfallClient"
        }
      }
    }
  }
}
