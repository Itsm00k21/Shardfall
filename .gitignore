# Rojo / Studio output. build/ stays in git so
# `rojo build -o build/Shardfall.rbxlx` has a directory to write into.
# Rojo does not create missing parent folders. Place files stay ignored.
*.rbxl
*.rbxlx
sourcemap.json

# Toolchain caches
.rokit/

# Wally install output. Reinstall with `wally install`.
/Packages/
/DevPackages/
/ServerPackages/

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Local smoke / agent state
ops/state.sqlite*

# Generated by scripts/stamp.sh (real git sha for the build stamp)
src/ReplicatedStorage/Shared/BuildStamp.luau
src/ReplicatedStorage/Shared/BuildStamp.luau.tmp
