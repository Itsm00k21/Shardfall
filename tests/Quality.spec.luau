--!strict

local framework = require("./framework")
local describe = framework.describe
local it = framework.it
local expect = framework.expect

local Quality = require("../src/ReplicatedStorage/Shared/Quality")

describe("Quality", function()
	it("accepts low, med, and high and rejects anything else", function()
		expect(Quality.normalize("low")).toEqual("low")
		expect(Quality.normalize("MED")).toEqual("med")
		expect(Quality.normalize("High")).toEqual("high")
		expect(Quality.normalize("")).toBeNil()
		expect(Quality.normalize("ultra")).toBeNil()
		expect(Quality.normalize(nil)).toBeNil()
		expect(Quality.ids()).toEqual({ "low", "med", "high" })
	end)

	it("defaults touch devices to low and keeps a saved tier", function()
		expect(Quality.resolve("", true)).toEqual("low")
		expect(Quality.resolve(nil, false)).toEqual("med")
		expect(Quality.resolve("high", true)).toEqual("high")
		expect(Quality.resolve("nope", true)).toEqual("low")
		expect(Quality.touchDevice(true, nil)).toBeTrue()
		expect(Quality.touchDevice(false, "touch")).toBeTrue()
		expect(Quality.touchDevice(false, "keyboard")).toBeFalse()
	end)

	it("keeps low under tighter part, particle, fog, and shadow budgets", function()
		local low = Quality.get("low")
		local med = Quality.get("med")
		local high = Quality.get("high")
		expect(low.particleBudget < med.particleBudget).toBeTrue()
		expect(med.particleBudget < high.particleBudget).toBeTrue()
		expect(low.partBudget < med.partBudget).toBeTrue()
		expect(med.partBudget < high.partBudget).toBeTrue()
		expect(low.particleScale < med.particleScale).toBeTrue()
		expect(med.particleScale < high.particleScale).toBeTrue()
		expect(low.decorKeep < med.decorKeep).toBeTrue()
		expect(med.decorKeep < high.decorKeep).toBeTrue()
		expect(low.bloom < med.bloom).toBeTrue()
		expect(med.bloom < high.bloom).toBeTrue()
		expect(low.fogEnd > med.fogEnd).toBeTrue()
		expect(med.fogEnd > high.fogEnd).toBeTrue()
		expect(low.lodHideAt < med.lodHideAt).toBeTrue()
		expect(med.lodHideAt < high.lodHideAt).toBeTrue()
		expect(low.decorShadows).toBeFalse()
		expect(high.decorShadows).toBeTrue()
		expect(Quality.castShadow("small", "high")).toBeFalse()
		expect(Quality.castShadow("large", "low")).toBeFalse()
		expect(Quality.castShadow("large", "high")).toBeTrue()

		local lowShown = Quality.shownTrim(200, "low")
		local medShown = Quality.shownTrim(200, "med")
		local highShown = Quality.shownTrim(200, "high")
		expect(lowShown < medShown).toBeTrue()
		expect(medShown < highShown).toBeTrue()
		expect(lowShown <= low.partBudget).toBeTrue()
		expect(highShown).toEqual(200)
		expect(Quality.particleRate(10, "low") < Quality.particleRate(10, "high")).toBeTrue()
		expect(Quality.particleEnabled(low.particleBudget + 1, "low")).toBeFalse()
		expect(Quality.particleEnabled(1, "low")).toBeTrue()
		expect(Quality.MIN_TAP >= 44).toBeTrue()
		expect(Quality.THUMB >= Quality.MIN_TAP).toBeTrue()
		expect(Quality.alwaysVisible("Waystone", nil)).toBeTrue()
		expect(Quality.alwaysVisible("Crystal", "forge")).toBeTrue()
		expect(Quality.alwaysVisible("Waterfall", nil)).toBeTrue()
		expect(Quality.alwaysVisible("Flower", nil)).toBeFalse()
		expect(Quality.alwaysVisible("Anvil", "")).toBeFalse()
	end)
end)
